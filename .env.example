# ============================================================
# Football Team Manager — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# The app works with defaults — no .env is required to start.
# ============================================================

# Flask settings (optional — defaults shown)
FLASK_ENV=development        # development | production
FLASK_DEBUG=1                # 1=on, 0=off (force-disabled in production)

# Port exposed by the app (must match docker-compose.yml)
APP_PORT=8080

# Monthly membership fee in BRL (default: 50.00)
VALOR_MENSALIDADE=50.00

# Path to the JSON database file (relative to project root)
DB_PATH=data/db.json
